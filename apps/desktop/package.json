{
  "name": "@callsheet/desktop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.renderer.json && node scripts/copy-renderer-assets.ts",
    "start": "pnpm build && electron .",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json --noEmit"
  },
  "devDependencies": {
    "@callsheet/api-types": "workspace:*",
    "@types/node": "^24.13.6",
    "electron": "44.4.5",
    "typescript": "7.0.2"
  }
}
